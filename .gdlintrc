max-line-length: 100
max-file-lines: 350
max-class-lines: 250
max-public-methods: 8
max-returns: 3
max-branches: 5
max-statements: 20
function-arguments-number: 4
function-preload-variable-name: "([A-Z][a-z0-9]*)+"
load-constant-name: "([A-Z][A-Z0-9_]*)"
class-name: "([A-Z][a-z0-9]*)+"
function-name: "_?[a-z][a-z0-9_]*"
class-variable-name: "_?[a-z][a-z0-9_]*"
function-argument-name: "_?[a-z][a-z0-9_]*"
loop-variable-name: "_?[a-z][a-z0-9_]*"
local-variable-name: "_?[a-z][a-z0-9_]*"
signal-name: "[a-z][a-z0-9_]*"
enum-name: "([A-Z][a-z0-9]*)+"
enum-element-name: "[A-Z][A-Z0-9_]*"
constant-name: "[A-Z][A-Z0-9_]*"
sub-class-name: "_?([A-Z][a-z0-9]*)+"
